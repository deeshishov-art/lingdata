    <TIER ANNOTATOR="@das2007m" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_meaning"
        PARENT_REF="gestType@eam2007f" PARTICIPANT="@eam2007f" TIER_ID="gestMeaning@eam2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>Она крутит немного головой, так она показывает, что ее город очень любим и важен для нее. Возможно, она вспоминает что-то про свой Иркутск.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>показывает, как близко находится город </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>Для прибавления изобразительности она вытягивает руку, чтобы показать как много достопримечательностей </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>Показывает, что есть определенная набережная</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>Спомошью руки показывает, что набережная находится недалко.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>Показывает и хочет привлечь внимание к тому, что эта река единственная вытекает из Байкала.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>Она акцентирует внимание, что в пригороде есть много чего</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>Сначала одной рукой показывает леса, затем другой природные достопримечательности</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Она хочет привлечь внимание к данной теме и показать, что она гордитмя символом города и ей нравится этот вопрос</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>Ей сложно собраться с мыслями, она жестикулирует, чтобы самоуспокоится и продолжить говорить.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>Этим жестом она привлекает внимание и показывает, что это было много лет тому назад.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>Жест привлекает внимание слушателя, он показывает  отношение Кати к данной теме</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
